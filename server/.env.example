# ─── Server environment variables ────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# JWT secret (change in production)
JWT_SECRET=change-me-in-production

# Admin credentials
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=your-secure-password
ADMIN_RECOVERY_EMAIL=kipkemoi386@gmail.com

# PostgreSQL connection string (Neon, Supabase, Render DB, etc.)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Cloudinary (https://cloudinary.com/console)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Optional SMTP settings for forgot-password email delivery
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=your-email@gmail.com

# ─── REQUIRED IN PRODUCTION (Render) ─────────────────────────────────────────
# Set to your Vercel frontend URL so CORS allows it
CLIENT_URL=https://your-app.vercel.app
